{
  "name": "qits-spa-ui-components",
  "version": "2026.1112.65904",
  "private": true,
  "description": "Angular workspace harness for @qits/ui-components. The publishable unit is the ng-packagr output under dist/ — this manifest only builds, tests and lints it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/QuicklyIterateTheSoftware/qits-spa-ui-components.git"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build qits-spa-ui-components && node scripts/check-exports.mjs",
    "test": "ng test qits-spa-ui-components",
    "test:browser": "ng run qits-spa-ui-components:test-browser && qits-angular screenshots --check --freezes projects/qits-spa-ui-components/src/testing/browser/freezes",
    "screenshots:prune": "qits-angular screenshots --prune",
    "lint": "ng lint qits-spa-ui-components",
    "check-exports": "node scripts/check-exports.mjs",
    "storybook": "ng run qits-spa-ui-components:storybook",
    "build-storybook": "ng run qits-spa-ui-components:build-storybook"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@angular-devkit/architect": "^0.2102.0",
    "@angular-devkit/core": "^21.2.0",
    "@angular-eslint/builder": "21.4.0",
    "@angular/animations": "^21.2.0",
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "17.1.4",
    "@qits/angular": "2026.1112.74140",
    "@qits/ci-golden-masters": "2026.1109.132507",
    "@qits/edge-golden-masters": "2026.1111.182144",
    "@qits/githost-golden-masters": "2026.1109.41303",
    "@qits/projects-golden-masters": "2026.1111.203405",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/angular-vite": "^10.5.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.1",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "angular-eslint": "21.4.0",
    "eslint": "^10.3.0",
    "jsdom": "^28.0.0",
    "mermaid": "^11.17.2",
    "ng-packagr": "^21.2.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "rxjs": "~7.8.0",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.12"
  }
}

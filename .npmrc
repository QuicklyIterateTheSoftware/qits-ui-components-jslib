# The pnpm store lives inside the checkout and packages are hard-linked from it, so `pnpm install`
# never calls copyFile (qits-617).
#
# On the external CI runner `qits-ci`, copyFile from the default store (~/.local/share/pnpm, in the
# step container's own filesystem) into /workspace failed with EAGAIN in every release gate on
# 2026-10-01 — four in a row, a different package each time, under both pnpm's default `auto`
# import and an explicit `copy`. A store on the same filesystem as node_modules lets pnpm link
# instead of copy. The store is fresh on every run there (`reused 0`), so nothing is lost by moving
# it; locally it costs one extra download of the packages into this directory.
store-dir=.pnpm-store
package-import-method=hardlink

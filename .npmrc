# Plain copies from the pnpm store, never a reflink clone (qits-617).
#
# pnpm's default `auto` import tries a copy-on-write clone first and falls back only on EXDEV or
# ENOTSUP. On the external CI runner `qits-ci` the clone attempt fails with EAGAIN instead, which pnpm
# does not treat as "unsupported", so `pnpm install` died three times in a row importing a different
# package each time (ERR_PNPM_EAGAIN ... copyfile). The store is fresh on every run there (`reused 0`),
# so a clone buys nothing; a plain copy costs nothing measurable.
package-import-method=copy

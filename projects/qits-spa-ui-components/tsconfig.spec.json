/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/spec",
    "types": ["vitest/globals", "node"],
    "resolveJsonModule": true,
    // The testing entry point imports the library by its package name, as ng-packagr requires of a
    // secondary entry point; its specs run against the sources, not a build.
    "paths": {
      "@qits/ui-components": ["./src/public-api.ts"]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "testing/**/*.spec.ts"]
}
